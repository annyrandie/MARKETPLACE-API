{
  "name": "marketplace-api",
  "version": "1.0.0",
  "description": "Marketplace API — OpenAPI contract (HW #9) + config/secrets: zod fail-fast, file-based DB password rotation (HW #11)",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "start:dev": "node --watch app.js",
    "check:env": "node scripts/check-env-example.mjs",
    "db:up": "bash scripts/up-db.sh",
    "db:rotate": "bash rotate.sh",
    "db:down": "docker compose down -v",
    "lint:spec": "redocly lint openapi/openapi.yaml",
    "bundle:spec": "redocly bundle openapi/openapi.yaml -o spec.json",
    "test": "echo \"no automated tests for variant B — see README, Verification section\" && exit 0"
  },
  "keywords": [],
