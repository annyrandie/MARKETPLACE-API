  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-openapi-validator": "^5.6.2",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@redocly/cli": "^2.46.0"
  }
}
