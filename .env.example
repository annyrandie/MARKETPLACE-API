# ─── .env.example convention ─────────────────────────────────────────────
# This file is the CONTRACT of the configuration: the full list of variables
# with comments. It lives in git. Real values live in .env, which is
# gitignored.
#
#   cp .env.example .env      ← first step after cloning
#
# Rules:
#   1. Every variable the app reads is listed here — even optional ones
#      (with the default noted in a comment).
#   2. Secret-shaped values here are FAKE or empty. Never real.
#   3. Added a variable in code → add it here in the SAME commit, or a
#      teammate's app won't start after `git pull`, and they lose half an
#      hour figuring out why. `npm run check:env` catches this in CI.

# HTTP server port. Optional, defaults to 3000.
PORT=3000

# Postgres connection string — WITHOUT a password. The password is never an
# env var; it lives in the file DB_PASSWORD_FILE points at and is re-read on
# every new connection, which is what makes rotation possible without a
# restart. Points at PgBouncer (HW #15), not at Postgres directly — matches
# docker-compose.yml's pgbouncer service, host port 6432. Direct Postgres
# access (db service) is still published on 5433, for admin/manual use only.
DB_URL=postgres://app_user@127.0.0.1:6432/marketplace

# Path (relative to the repo root) to the file holding the DB password.
# Optional, defaults to secrets/db_password.
DB_PASSWORD_FILE=secrets/db_password

# Log level: debug | info | warn | error. Optional, defaults to info.
LOG_LEVEL=info

# Timeout for external calls (currently: the Postgres connection timeout), in ms.
# Optional, defaults to 5000.
TIMEOUT_MS=5000

# HW #23: the cache Redis (allkeys-lru + maxmemory — it may forget).
# Optional, defaults to docker-compose.yml's redis-cache. A real deployment
# with auth: rediss://user:<password>@host:port — then it belongs in the
# vault (secrets/redis_url, see scripts/with-secrets.sh), not in .env.
REDIS_URL=redis://127.0.0.1:6379

# HW #23: the state Redis (noeviction + AOF) — BullMQ, sessions, rate-limit
# counters. Optional, defaults to docker-compose.yml's redis-queue. NEVER
# the same instance as REDIS_URL: an LRU box would evict sessions and jobs.
REDIS_QUEUE_URL=redis://127.0.0.1:6380

# ─── HW #24: signing material — from the VAULT, never from this file ─────
# Listed here only because rule 1 says every variable the app reads is
# listed. Leave them EMPTY in .env: `npm run start:vault` (and every demo)
# fills them from secrets/<env>/ via scripts/with-secrets.sh, generated by
# `npm run keys:generate -- dev`. Bare `npm run start` without them refuses
# to start and names what's missing — there are no defaults, on purpose.
#
# ES256 (P-256) private key, PKCS#8 PEM, base64-encoded (one line). Required.
JWT_PRIVATE_KEY=
# Its public key, SPKI PEM, base64-encoded. Required.
JWT_PUBLIC_KEY=
# Key id written into every token header (kid). Required.
JWT_KID=
# HMAC key for refresh-token hashes, ≥ 32 characters. Required.
REFRESH_TOKEN_PEPPER=
# Only during a signing-key rotation: the previous key, verify-only.
JWT_PREVIOUS_KID=
JWT_PREVIOUS_PUBLIC_KEY=

# ─── HW #26: object storage (S3 API) ──────────────────────────────────────
# Access key pair: from the VAULT (secrets/<env>/storage_access_key,
# storage_secret_key via scripts/with-secrets.sh) — leave EMPTY here. It is
# read+write on every file in the bucket. Required, no defaults.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# S3 endpoint. Local: docker-compose.yml's RustFS. EMPTY = real AWS S3.
STORAGE_ENDPOINT=http://127.0.0.1:9100
# Optional, default us-east-1.
STORAGE_REGION=us-east-1
# Optional, default marketplace-files. Private — never made public.
STORAGE_BUCKET=marketplace-files
# Lifetime of a presigned single-PUT URL, seconds (1..3600). Optional,
# default 300 — see README, Files, for why 5 minutes.
UPLOAD_URL_TTL_SECONDS=300

# ─── HW #28: lifecycle (probes + graceful shutdown) ──────────────────────
# Minimum warm-up before the server starts listening, ms. Optional,
# default 0 locally; the Kubernetes Deployment sets 4000.
WARMUP_MS=0
# After SIGTERM: readiness red, socket still open, for this long — then
# close(). Optional, default 5000. Must stay below the pod's
# terminationGracePeriodSeconds.
DRAIN_MS=5000
