# ─── .env.example convention ─────────────────────────────────────────────
# This file is the CONTRACT of the configuration: the full list of variables
# with comments. It lives in git. Real values live in .env, which is
# gitignored.
#
#   cp .env.example .env      ← first step after cloning
#
# Rules:
#   1. Every variable the app reads is listed here — even optional ones
#      (with the default noted in a comment).
#   2. Secret-shaped values here are FAKE or empty. Never real.
#   3. Added a variable in code → add it here in the SAME commit, or a
#      teammate's app won't start after `git pull`, and they lose half an
#      hour figuring out why. `npm run check:env` catches this in CI.

# HTTP server port. Optional, defaults to 3000.
PORT=3000

# Postgres connection string — WITHOUT a password. The password is never an
# env var; it lives in the file DB_PASSWORD_FILE points at and is re-read on
# every new connection, which is what makes rotation possible without a
# restart. Matches docker-compose.yml (db service, host port 5433).
DB_URL=postgres://app_user@127.0.0.1:5433/marketplace

# Path (relative to the repo root) to the file holding the DB password.
# Optional, defaults to secrets/db_password.
DB_PASSWORD_FILE=secrets/db_password

# Log level: debug | info | warn | error. Optional, defaults to info.
LOG_LEVEL=info

# Timeout for external calls (currently: the Postgres connection timeout), in ms.
# Optional, defaults to 5000.
TIMEOUT_MS=5000
